		Abilities = {
			{ Id = "Hypnosis", Kind = "StunPulse", Cooldown = 10, Radius = 28, Damage = 4, Stun = 2.5, MinRange = 0, MaxRange = 26 },
			{ Id = "CardFan", Kind = "Barrage", Cooldown = 6, Count = 3, Spread = 18, Damage = 12, Speed = 100, Range = 100, Size = 1.2, MinRange = 8, MaxRange = 85 },
