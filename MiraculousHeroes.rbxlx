			{ Id = "InkBarrage", Kind = "Barrage", Cooldown = 7, Count = 5, Spread = 28, Damage = 10, Speed = 90, Range = 110, Size = 1.4, MinRange = 10, MaxRange = 90 },
			{ Id = "InkBurst", Kind = "Shockwave", Cooldown = 8, Radius = 16, Damage = 16, Stun = 0.6, Knockback = 45, MinRange = 0, MaxRange = 14 },
