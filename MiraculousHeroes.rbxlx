            <Item class="ModuleScript" referent="RBX15">
              <Properties>
                <string name="Name">AkumaFX</string>
                <ProtectedString name="Source">--[[ Efeitos de akumatização, purificação e habilidades de vilões ]]
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Shared = RS:WaitForChild("MiraculousShared")
local Util = require(Shared.Util)
local Lib = require(Shared.VFX.VFXLib)

local E = {}
local DARK = Color3.fromRGB(120, 40, 200)

-- Borboleta gerada por script: corpo + 2 asas (WedgeParts) batendo
local function makeButterfly(color)
	local model = Instance.new("Model")
	local body = Util.New("Part", {
		Size = Vector3.new(0.3, 0.3, 1.2), Anchored = true, CanCollide = false, CanQuery = false,
		Material = Enum.Material.Neon, Color = color, CastShadow = false, Name = "Body",
	}, model)
	local wings = {}
	for i = 1, 2 do
		wings[i] = Util.New("Part", {
			Size = Vector3.new(1.8, 0.08, 1.6), Anchored = true, CanCollide = false, CanQuery = false,
			Material = Enum.Material.Neon, Color = color, Transparency = 0.2, CastShadow = false,
		}, model)
	end
	local a0 = Util.New("Attachment", { Position = Vector3.new(0, 0, 0.6) }, body)
	local a1 = Util.New("Attachment", { Position = Vector3.new(0, 0, -0.6) }, body)
	Util.New("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.8, LightEmission = 1,
		Color = ColorSequence.new(color), Transparency = NumberSequence.new(0.2, 1), WidthScale = NumberSequence.new(1, 0) }, body)
	Util.New("PointLight", { Color = color, Range = 12, Brightness = 2 }, body)
	Lib.Emitter(body, { Color = color, Rate = 25, Speed = NumberRange.new(0.5, 2), Lifetime = NumberRange.new(0.5, 1) })
	model.Parent = workspace
	local function place(cf, t)
		body.CFrame = cf
		local flap = math.sin(t * 22) * 0.9
		wings[1].CFrame = cf * CFrame.new(1.0, 0, 0) * CFrame.Angles(0, 0, flap)
		wings[2].CFrame = cf * CFrame.new(-1.0, 0, 0) * CFrame.Angles(0, 0, -flap)
	end
	return model, place
end
E._makeButterfly = makeButterfly

-- Borboleta voa de "from" até o alvo e mergulha nele
function E.AkumaFly(d)
	local target = d.To
	local hrp = target and target:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local from = d.From
	local dur = d.Duration or 3
	local model, place = makeButterfly(DARK)
	Lib.Sound("Akuma", hrp)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / dur
		if t &gt;= 1 or not hrp.Parent then
			conn:Disconnect()
			model:Destroy()
			if hrp.Parent then
				local pos = hrp.Position
				Lib.Flash(DARK, 0.25, 0.8)
				Lib.Sphere(pos, DARK, 2, 16, 0.6, 0.3)
				Lib.Burst(pos, DARK, 70, 35, 1.2, 1.1, Color3.fromRGB(255, 80, 200))
				Lib.Lightning(pos + Vector3.new(0, 14, 0), pos, DARK, 8, 3, 0.5, 0.4)
				Lib.Shake(0.35, 0.5)
			end
			return
		end
		local goal = hrp.Position + Vector3.new(0, 1.5, 0)
		local wob = Vector3.new(math.sin(t * 14) * 4, math.cos(t * 9) * 3, math.cos(t * 12) * 4) * (1 - t)
		local pos = from:Lerp(goal, t * t * (3 - 2 * t)) + wob
		place(CFrame.lookAt(pos, goal), os.clock())
	end)
end

-- Transformação em vilão: aura escura, anéis, butterfly mask de partículas
function E.AkumaTransform(d)
	local char = d.Char
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not Lib.InRange(hrp.Position) then return end
	local c = d.Color or DARK
	local feet = hrp.Position - Vector3.new(0, 2.8, 0)
	Lib.Flash(DARK, 0.3, 0.9)
	Lib.Pillar(feet, DARK, 3.5, 50, 1)
	for i = 1, 3 do Lib.Ring(feet, i % 2 == 0 and c or DARK, 3, 12 + i * 8, 0.6 + 0.15 * i, 0.4) end
	Lib.Burst(hrp.Position, DARK, 100, 45, 1.4, 1.3, c)
	Lib.Light(hrp.Position, c, 40, 6, 1)
	Lib.Spiral(char, DARK, 1.2, 6, 4, 7)
	Lib.Shake(0.5, 0.6)
end

-- Akuma liberada: pulso e aviso
function E.AkumaReleased(d)
	local part = d.Part
	if not (part and part.Parent) then return end
	Lib.Burst(part.Position, DARK, 40, 20, 1, 1)
	Lib.Ring(part.Position, DARK, 1, 14, 0.6, 0.2, true)
	Lib.Emitter(part, { Color = DARK, Color2 = Color3.fromRGB(255, 80, 200), Rate = 40, Speed = NumberRange.new(1, 4), Lifetime = NumberRange.new(0.8, 1.4) })
	local att0 = Util.New("Attachment", { Position = Vector3.new(0, 0.5, 0) }, part)
	local att1 = Util.New("Attachment", { Position = Vector3.new(0, -0.5, 0) }, part)
	Util.New("Trail", { Attachment0 = att0, Attachment1 = att1, Lifetime = 1, LightEmission = 1,
		Color = ColorSequence.new(DARK), Transparency = NumberSequence.new(0.2, 1) }, part)
end

-- Purificação: yo-yo captura e a borboleta vira branca e voa
function E.Purify(d)
	local pos = d.Position
	if not Lib.InRange(pos) then return end
	local from = d.From and d.From:FindFirstChild("HumanoidRootPart")
	if from then Lib.Line(from.Position + Vector3.new(0, 1, 0), pos, Color3.fromRGB(255, 70, 90), 0.25, 0.4) end
	Lib.Sound("Purify")
	Lib.Flash(Color3.new(1, 1, 1), 0.35, 0.8)
	Lib.Sphere(pos, DARK, 2, 8, 0.25, 0.2)
	Lib.Sphere(pos, Color3.new(1, 1, 1), 1, 14, 0.7, 0.2)
	Lib.Burst(pos, Color3.new(1, 1, 1), 60, 25, 1, 1.2)
	Lib.Ring(pos, Color3.new(1, 1, 1), 1, 18, 0.7, 0.2, true)
	local model, place = makeButterfly(Color3.new(1, 1, 1))
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / 3
		if t &gt;= 1 then conn:Disconnect(); model:Destroy() return end
		local p = pos + Vector3.new(math.sin(t * 8) * 3, t * 70, math.cos(t * 6) * 3)
		place(CFrame.lookAt(p, p + Vector3.new(0.2, 1, 0)), os.clock())
	end)
end

function E.Deakuma(d)
	local hrp = d.Char and d.Char:FindFirstChild("HumanoidRootPart")
	if not hrp or not Lib.InRange(hrp.Position) then return end
	Lib.Burst(hrp.Position, Color3.new(1, 1, 1), 50, 16, 0.9, 1.4, Color3.fromRGB(180, 255, 200))
	Lib.Ring(hrp.Position - Vector3.new(0, 2.8, 0), Color3.new(1, 1, 1), 2, 16, 0.9, 0.2)
	Lib.Light(hrp.Position, Color3.new(1, 1, 1), 28, 3, 1)
end

function E.Shockwave(d)
	if not Lib.InRange(d.Position) then return end
	local c = d.Color or DARK
	local feet = d.Position - Vector3.new(0, 2.8, 0)
	Lib.Ring(feet, c, 2, d.Radius * 2, 0.5, 0.5)
	Lib.Ring(feet, Color3.new(1, 1, 1), 2, d.Radius * 2.4, 0.7, 0.2)
	Lib.Burst(feet, c, 60, 35, 1.3, 0.9)
	Lib.Light(d.Position, c, 30, 4, 0.5)
	Lib.Shake(0.4, 0.4)
end

function E.StunPulse(d)
	if not Lib.InRange(d.Position) then return end
	local c = d.Color or DARK
	for i = 1, 3 do
		task.delay(i * 0.1, function() Lib.Sphere(d.Position, c, 2, d.Radius * 2, 0.5, 0.6) end)
	end
	Lib.Burst(d.Position, c, 40, 30, 1, 0.8)
end

function E.Warp(d)
	local c = d.Color or DARK
	Lib.Burst(d.From, c, 40, 25, 1, 0.8)
	Lib.Line(d.From, d.To, c, 1.2, 0.35)
	Lib.Burst(d.To, c, 40, 25, 1, 0.8)
	Lib.Sphere(d.To, c, 1, 10, 0.3)
end

-- Aura permanente em vilões (via Tag "AkumaVillain" - cobre quem entrou depois)
function E.Setup()
	local active = {}
	local function attach(char)
		if active[char] then return end
		local color = char:GetAttribute("AuraColor") or DARK
		active[char] = Lib.Aura(char, color, 24)
	end
	local function detach(char)
		if active[char] then active[char](); active[char] = nil end
	end
	CollectionService:GetInstanceAddedSignal("AkumaVillain"):Connect(function(c) task.wait(0.1); attach(c) end)
	CollectionService:GetInstanceRemovedSignal("AkumaVillain"):Connect(detach)
	for _, c in ipairs(CollectionService:GetTagged("AkumaVillain")) do attach(c) end
end

return E
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX16">
              <Properties>
                <string name="Name">CombatFX</string>
                <ProtectedString name="Source">--[[ Efeitos de combate: impacto, bloqueio, golpe, esquiva, stun, confusão, cura, escudos ]]
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("MiraculousShared")
local Util = require(Shared.Util)
local Lib = require(Shared.VFX.VFXLib)

local E = {}

function E.Impact(d)
	if not Lib.InRange(d.Position) then return end
	local c, s = d.Color or Color3.new(1, 1, 1), d.Size or 1
	Lib.Burst(d.Position, c, 14 * s, 22, 0.7 * s, 0.4, Color3.new(1, 1, 1))
	Lib.Sphere(d.Position, c, 0.5, 4 * s, 0.18, 0.2)
	Lib.Ring(d.Position, c, 0.5, 6 * s, 0.25, 0.15, true)
	Lib.Light(d.Position, c, 10 * s, 3, 0.2)
	Lib.Sound("Impact")
	if s &gt; 2 then Lib.Shake(0.15, 0.15) end
end

function E.Block(d)
	if not Lib.InRange(d.Position) then return end
	local c = d.Perfect and Color3.fromRGB(255, 240, 130) or Color3.fromRGB(150, 200, 255)
	Lib.Burst(d.Position, c, d.Perfect and 40 or 18, 28, 0.8, 0.5)
	Lib.Ring(d.Position, c, 1, d.Perfect and 14 or 8, 0.35, 0.15, true)
	Lib.Light(d.Position, c, 14, 3, 0.25)
	Lib.Sound("Block")
end

-- Arco de corte na frente do personagem
function E.Slash(d)
	local hrp = d.Char and d.Char:FindFirstChild("HumanoidRootPart")
	if not hrp or not Lib.InRange(hrp.Position) then return end
	local c = d.Color or Color3.new(1, 1, 1)
	local combo = d.Combo or 1
	local tilt = (combo % 2 == 0) and 25 or -25
	local arc = Util.New("Part", {
		Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false, CanQuery = false, Material = Enum.Material.Neon,
		Color = c, Transparency = 0.25, Size = Vector3.new(0.12, 8, 8), CastShadow = false,
		CFrame = hrp.CFrame * CFrame.new(0, 0.3, -4.5) * CFrame.Angles(math.rad(90), 0, math.rad(tilt)) * CFrame.Angles(0, 0, math.rad(90)),
	}, workspace)
	arc.Size = Vector3.new(0.12, 8, 8)
	Util.Tween(arc, 0.2, { Size = Vector3.new(0.05, 11, 11), Transparency = 1 })
	Util.Clean(arc, 0.3)
	if combo == 4 then
		Lib.Ring(hrp.Position - Vector3.new(0, 2.8, 0), c, 2, 16, 0.4, 0.2)
		Lib.Shake(0.2, 0.2)
	end
end

function E.Dodge(d)
	local char = d.Char
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not Lib.InRange(hrp.Position) then return end
	-- imagens residuais: cópias neon translúcidas dos membros
	for i = 1, Lib.Count(3) do
		task.delay((i - 1) * 0.05, function()
			if not char.Parent then return end
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					local g = Util.New("Part", {
						Anchored = true, CanCollide = false, CanQuery = false, Material = Enum.Material.Neon,
						Color = Color3.fromRGB(180, 220, 255), Transparency = 0.5, Size = part.Size, CFrame = part.CFrame, CastShadow = false,
					}, workspace)
					Util.Tween(g, 0.35, { Transparency = 1 })
					Util.Clean(g, 0.4)
				end
			end
		end)
	end
	Lib.Burst(hrp.Position, Color3.fromRGB(200, 230, 255), 12, 12, 0.6, 0.4)
end

-- Estrelinhas girando sobre a cabeça enquanto stun
function E.Stun(d)
	local head = d.Char and d.Char:FindFirstChild("Head")
	if not head or not Lib.InRange(head.Position) then return end
	local att = Util.New("Attachment", { Position = Vector3.new(0, 1.4, 0) }, head)
	local e = Lib.Emitter(att, { Color = Color3.fromRGB(255, 240, 120), Rate = 12, Speed = NumberRange.new(0.5, 1.5), Lifetime = NumberRange.new(0.6, 1) })
	task.delay(d.Duration or 1, function() e.Enabled = false; Util.Clean(att, 1) end)
end

function E.Confuse(d)
	local head = d.Char and d.Char:FindFirstChild("Head")
	if not head or not Lib.InRange(head.Position) then return end
	local att = Util.New("Attachment", { Position = Vector3.new(0, 1.6, 0) }, head)
	local e = Lib.Emitter(att, { Color = Color3.fromRGB(255, 150, 50), Color2 = Color3.fromRGB(255, 230, 120), Rate = 16, Speed = NumberRange.new(1, 3), Lifetime = NumberRange.new(0.8, 1.3), Acceleration = Vector3.new(0, 2, 0) })
	task.delay(d.Duration or 4, function() e.Enabled = false; Util.Clean(att, 1.5) end)
end

function E.Heal(d)
	local hrp = d.Char and d.Char:FindFirstChild("HumanoidRootPart")
	if not hrp or not Lib.InRange(hrp.Position) then return end
	Lib.Burst(hrp.Position, Color3.fromRGB(255, 120, 150), 30, 10, 0.7, 1.2, Color3.fromRGB(255, 255, 255))
	Lib.Ring(hrp.Position - Vector3.new(0, 2.8, 0), Color3.fromRGB(255, 150, 170), 2, 10, 0.8, 0.2)
end

function E.ShieldHit(d)
	if not Lib.InRange(d.Position) then return end
	local c = Color3.fromRGB(100, 255, 160)
	Lib.Burst(d.Position, c, 16, 14, 0.7, 0.4)
	Lib.Ring(d.Position, c, 1, 6, 0.3, 0.12, true)
end

function E.ShieldBreak(d)
	if not Lib.InRange(d.Position) then return end
	local c = Color3.fromRGB(100, 255, 160)
	Lib.Burst(d.Position, c, 80, 40, 1.2, 1, Color3.new(1, 1, 1))
	Lib.Sphere(d.Position, c, d.Radius * 2, d.Radius * 3, 0.4, 0.6)
	Lib.Shake(0.25, 0.25)
end

function E.ShieldFade(d)
	if not Lib.InRange(d.Position) then return end
	Lib.Burst(d.Position, Color3.fromRGB(100, 255, 160), 30, 14, 0.8, 0.8)
end

return E
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX17">
              <Properties>
                <string name="Name">PowerFX</string>
                <ProtectedString name="Source">--[[ Efeitos dos poderes de cada herói (somente visuais; a lógica está em ServerScriptService/.../Powers) ]]
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Shared = RS:WaitForChild("MiraculousShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Lib = require(Shared.VFX.VFXLib)

local E = {}
local RED, BLACK = Color3.fromRGB(235, 25, 45), Color3.fromRGB(15, 15, 18)

local function hand(char)
	return char and (char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart"))
end
local function root(char) return char and char:FindFirstChild("HumanoidRootPart") end
local function feetOf(pos) return pos - Vector3.new(0, 2.8, 0) end

-- Corre uma função por frame durante `time` segundos; f(t01) -&gt; false para encerrar antes
local function animate(time, f)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / time
		if t &gt;= 1 or f(t) == false then conn:Disconnect() end
	end)
end

------------------------------------------------------------------ LADYBUG
function E.LuckyCharm(d)
	local pos = d.Position
	if not Lib.InRange(pos) then return end
	local c = d.Color or RED
	Lib.Sound("LuckyCharm")
	Lib.Flash(RED, 0.3, 0.7)
	Lib.Ring(feetOf(pos - Vector3.new(0, 3, 0)), c, 2, 16, 0.7, 0.25)
	-- bola vermelha com bolinhas pretas desce girando e some em brilho
	local ball = Util.New("Part", { Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, Anchored = true, CanCollide = false,
		CanQuery = false, Material = Enum.Material.Neon, Color = RED, CastShadow = false }, workspace)
	local dots = {}
	for i = 1, 7 do
		dots[i] = Util.New("Part", { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.55, Anchored = true, CanCollide = false,
			CanQuery = false, Color = BLACK, Material = Enum.Material.SmoothPlastic, CastShadow = false }, workspace)
	end
	Util.New("PointLight", { Color = RED, Range = 18, Brightness = 3 }, ball)
	local char = d.Char
	animate(1.4, function(t)
		local hr = root(char)
		local p = pos:Lerp(hr and (hr.Position + Vector3.new(0, 1, 0)) or pos, t * t) + Vector3.new(0, math.sin(t * 12) * 0.4, 0)
		ball.CFrame = CFrame.new(p) * CFrame.Angles(0, t * 14, 0)
		for i, dot in ipairs(dots) do
			local dir = Vector3.new(math.cos(i * 1.1), math.sin(i * 2.3), math.sin(i * 1.1)).Unit
			dot.CFrame = ball.CFrame * CFrame.new(dir * 1.2)
		end
		ball.Transparency = t &gt; 0.85 and (t - 0.85) / 0.15 or 0
		for _, dot in ipairs(dots) do dot.Transparency = ball.Transparency end
		if t &gt; 0.99 then ball:Destroy(); for _, dot in ipairs(dots) do dot:Destroy() end end
	end)
	task.delay(1.4, function() Lib.Burst(pos, RED, 60, 28, 1.1, 1, BLACK) end)
	Lib.Burst(pos, RED, 40, 20, 0.9, 1, Color3.new(1, 1, 1))
end

function E.LuckyVision(d)
	local list = {}
	local function mark(part)
		local h = Util.New("Highlight", { Adornee = part, FillColor = RED, OutlineColor = Color3.new(1, 1, 1),
			FillTransparency = 0.5, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, part)
		table.insert(list, h)
	end
	for _, p in ipairs(CollectionService:GetTagged("LuckyTarget")) do
		if p:IsA("BasePart") or p:IsA("Model") then mark(p) end
	end
	for _, v in ipairs(CollectionService:GetTagged("AkumaVillain")) do
		for _, part in ipairs(v:GetDescendants()) do
			if part:IsA("BasePart") and part:GetAttribute("AkumaObject") then mark(part) end
		end
	end
	Lib.Tint(Color3.fromRGB(255, 190, 190), -0.2, 0.6, d.Duration or 12)
	task.delay(d.Duration or 12, function() for _, h in ipairs(list) do h:Destroy() end end)
end

function E.MiraculousLadybug(d)
	local pos, radius = d.Position, d.Radius or 90
	Lib.Sound("MiraculousLadybug")
	Lib.Flash(RED, 0.4, 1.2)
	Lib.Pillar(feetOf(pos), RED, 4, 80, 1.2)
	Lib.Ring(feetOf(pos), RED, 4, radius * 2, 1.6, 0.4)
	Lib.Ring(feetOf(pos), Color3.new(1, 1, 1), 4, radius * 2.2, 1.9, 0.2)
	-- enxame de joaninhas: sobe em espiral e depois se espalha pelo raio
	local swarm = {}
	for i = 1, Lib.Count(70) do
		local p = Util.New("Part", { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, Anchored = true, CanCollide = false,
			CanQuery = false, Material = Enum.Material.Neon, Color = RED, CastShadow = false }, workspace)
		local a0 = Util.New("Attachment", { Position = Vector3.new(0, 0.3, 0) }, p)
		local a1 = Util.New("Attachment", { Position = Vector3.new(0, -0.3, 0) }, p)
		Util.New("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.5, LightEmission = 1,
			Color = ColorSequence.new(RED), Transparency = NumberSequence.new(0.2, 1) }, p)
		swarm[i] = { part = p, ang = math.random() * math.pi * 2, rad = math.random() * 3, spd = 0.7 + math.random() }
	end
	animate(2.6, function(t)
		for _, s in ipairs(swarm) do
			local up = math.min(t / 0.35, 1)
			local spread = math.max((t - 0.35) / 0.65, 0)
			local r = s.rad + spread * radius
			local a = s.ang + t * 8 * s.spd
			s.part.Position = pos + Vector3.new(math.cos(a) * r, up * 40 * (1 - spread) + spread * math.sin(a * 2) * 6 + 2, math.sin(a) * r)
			s.part.Transparency = spread &gt; 0.85 and (spread - 0.85) / 0.15 or 0
		end
		if t &gt; 0.99 then for _, s in ipairs(swarm) do s.part:Destroy() end end
	end)
	task.delay(1.2, function()
		Lib.Burst(pos, Color3.fromRGB(255, 120, 150), 120, 80, 1.3, 1.6, Color3.new(1, 1, 1))
		Lib.Sphere(pos, RED, 5, radius * 1.4, 1, 0.7)
		Lib.Shake(0.3, 0.6)
	end)
end

function E.Yoyo(d)
	local h = hand(d.Char)
	if not h or not Lib.InRange(d.To) then return end
	local c = d.Color or RED
	local from = h.Position
	local line = Lib.Line(from, d.To, c, 0.2, nil)
	local ball = Util.New("Part", { Shape = Enum.PartType.Ball, Size = Vector3.one * 1.1, Anchored = true, CanCollide = false,
		CanQuery = false, Material = Enum.Material.Neon, Color = c, CFrame = CFrame.new(d.To) }, workspace)
	animate(0.7, function()
		local p0 = h.Position
		line.Size = Vector3.new(0.2, 0.2, (d.To - p0).Magnitude)
		line.CFrame = CFrame.lookAt(p0 + (d.To - p0) / 2, d.To)
	end)
	task.delay(0.7, function() line:Destroy(); ball:Destroy() end)
	Lib.Burst(d.To, c, 20, 18, 0.7, 0.5)
	Lib.Ring(d.To, c, 1, 6, 0.3, 0.15, true)
end

------------------------------------------------------------------ CAT NOIR
local cataStops = {}
function E.CataclysmCharge(d)
	local h = hand(d.Char)
	if not h then return end
	local c = Color3.fromRGB(110, 255, 90)
	Lib.Sound("Cataclysm", h)
	Lib.Flash(Color3.fromRGB(30, 0, 40), 0.1, 0.6)
	local att = Util.New("Attachment", { Position = Vector3.new(0, -1.1, 0) }, h)
	local e1 = Lib.Emitter(att, { Color = BLACK, Color2 = Color3.fromRGB(70, 0, 90), Rate = 60, Speed = NumberRange.new(1, 4),
		Lifetime = NumberRange.new(0.5, 1), LightEmission = 0.2, Texture = Config.VFX.Smoke,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }) })
	local e2 = Lib.Emitter(att, { Color = c, Rate = 40, Speed = NumberRange.new(2, 6), Lifetime = NumberRange.new(0.3, 0.7) })
	local light = Util.New("PointLight", { Color = c, Range = 14, Brightness = 2 }, h)
	local alive = true
	task.spawn(function()
		while alive and h.Parent do
			local p = h.Position - Vector3.new(0, 1, 0)
			Lib.Lightning(p, p + Util.RandomUnit() * 4, c, 4, 0.8, 0.12, 0.15)
			task.wait(0.12)
		end
	end)
	cataStops[d.Char] = function()
		alive = false
		e1.Enabled, e2.Enabled = false, false
		light:Destroy()
		Util.Clean(att, 1.2)
	end
	task.delay(d.Duration or 12, function() if cataStops[d.Char] then cataStops[d.Char](); cataStops[d.Char] = nil end end)
end

function E.CataclysmEnd(d)
	if cataStops[d.Char] then cataStops[d.Char](); cataStops[d.Char] = nil end
end

function E.CataclysmHit(d)
	if not Lib.InRange(d.Position) then return end
	local c = Color3.fromRGB(110, 255, 90)
	local s = d.Size or 8
	Lib.Sphere(d.Position, BLACK, 1, s, 0.5, 0.2)
	Lib.Sphere(d.Position, c, 1, s * 0.7, 0.35, 0.3)
	Lib.Burst(d.Position, BLACK, 60, 18, 1.5, 1.2, Color3.fromRGB(80, 0, 100))
	Lib.Burst(d.Position, c, 50, 30, 0.9, 0.9)
	for _ = 1, 4 do Lib.Lightning(d.Position, d.Position + Util.RandomUnit() * s, c, 6, 1.2, 0.2, 0.4) end
	Lib.Light(d.Position, c, 25, 4, 0.7)
	Lib.Shake(0.45, 0.45)
end

function E.BatonLeap(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local c = d.Color or Color3.fromRGB(120, 255, 80)
	Lib.Ring(feetOf(r.Position), c, 2, 12, 0.45, 0.25)
	Lib.Burst(feetOf(r.Position), c, 30, 28, 0.9, 0.6)
	local att = Util.New("Attachment", {}, r)
	local e = Lib.Emitter(att, { Color = c, Rate = 80, Speed = NumberRange.new(0, 2), Lifetime = NumberRange.new(0.4, 0.7) })
	task.delay(0.9, function() e.Enabled = false; Util.Clean(att, 1) end)
end

function E.StaffSpin(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local c = d.Color or Color3.fromRGB(120, 255, 80)
	local rings = {}
	for i = 1, 2 do
		rings[i] = Util.New("Part", { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 9 + i * 2, 9 + i * 2), Anchored = true,
			CanCollide = false, CanQuery = false, Material = Enum.Material.Neon, Color = c, Transparency = 0.45, CastShadow = false }, workspace)
	end
	local dur = d.Duration or 1.5
	animate(dur, function(t)
		if not r.Parent then return false end
		for i, ring in ipairs(rings) do
			ring.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, t * 30 * (i == 1 and 1 or -1), 0) * CFrame.Angles(0, 0, math.rad(90 + i * 8))
			ring.Transparency = 0.45 + t * 0.55
		end
		if t &gt; 0.98 then for _, ring in ipairs(rings) do ring:Destroy() end end
	end)
	Lib.Burst(r.Position, c, 30, 30, 0.8, 0.6)
end

------------------------------------------------------------------ RENA ROUGE
local ORANGE = Color3.fromRGB(255, 150, 50)
function E.Mirage(d)
	local pos, radius = d.Position, d.Radius or 40
	if not Lib.InRange(pos) then return end
	Lib.Flash(ORANGE, 0.25, 0.8)
	Lib.Sphere(pos, ORANGE, 2, radius * 1.2, 1.0, 0.75)
	for i = 1, 4 do
		task.delay(i * 0.12, function() Lib.Ring(feetOf(pos), i % 2 == 0 and Color3.fromRGB(255, 230, 150) or ORANGE, 2, radius * 1.5, 0.9, 0.2) end)
	end
	Lib.Burst(pos, ORANGE, 100, 40, 1.2, 1.4, Color3.fromRGB(255, 240, 180))
	Lib.Light(pos, ORANGE, 40, 4, 1)
end

function E.MirageAppear(d)
	if not Lib.InRange(d.Position) then return end
	Lib.Burst(d.Position + Vector3.new(0, 2, 0), d.Color or ORANGE, 40, 14, 1, 0.9, Color3.new(1, 1, 1))
	Lib.Ring(feetOf(d.Position + Vector3.new(0, 3, 0)), d.Color or ORANGE, 1, 9, 0.5, 0.2)
end

function E.FluteBlast(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local c = d.Color or ORANGE
	for i = 1, 5 do
		task.delay(i * 0.05, function()
			local cf = r.CFrame * CFrame.new(0, 0.5, -3 - i * 4)
			local ring = Lib.Ring(cf.Position, c, 2, 10 + i * 2, 0.4, 0.2, true)
			ring.CFrame = cf * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, 0, math.rad(-90))
		end)
	end
	Lib.Burst((r.CFrame * CFrame.new(0, 1, -6)).Position, c, 40, 40, 0.9, 0.7, Color3.new(1, 1, 1))
end

------------------------------------------------------------------ CARAPACE
local GREEN = Color3.fromRGB(100, 255, 160)
function E.Shellter(d)
	local pos, radius = d.Position, d.Radius or 22
	if not Lib.InRange(pos) then return end
	Lib.Flash(GREEN, 0.25, 0.6)
	Lib.Sphere(pos, GREEN, 2, radius * 2, 0.5, 0.5)
	for i = 0, 4 do
		task.delay(i * 0.08, function() Lib.Ring(feetOf(pos) + Vector3.new(0, i * radius * 0.4, 0), GREEN, 2, radius * 1.8, 0.7, 0.2) end)
	end
	Lib.Burst(pos, GREEN, 80, 45, 1.2, 1.2, Color3.new(1, 1, 1))
	Lib.Light(pos, GREEN, 40, 5, 1)
	Lib.Shake(0.2, 0.4)
end

function E.ShellSpin(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local c = d.Color or GREEN
	local ring = Util.New("Part", { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 8, 8), Anchored = true, CanCollide = false,
		CanQuery = false, Material = Enum.Material.Neon, Color = c, Transparency = 0.4, CastShadow = false }, workspace)
	local att = Util.New("Attachment", {}, r)
	local e = Lib.Emitter(att, { Color = c, Rate = 90, Speed = NumberRange.new(0, 3), Lifetime = NumberRange.new(0.3, 0.6) })
	animate(d.Duration or 0.9, function(t)
		if not r.Parent then return false end
		ring.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, t * 40, 0) * CFrame.Angles(0, 0, math.rad(80))
		if t &gt; 0.97 then ring:Destroy(); e.Enabled = false; Util.Clean(att, 0.8) end
	end)
end

------------------------------------------------------------------ VIPERION
local TEAL = Color3.fromRGB(90, 255, 230)
function E.SecondChance(d)
	local pos = d.Position
	local c = d.Color or TEAL
	Lib.Sound("Cataclysm") -- opcional: troque por seu som em Config.Sounds
	Lib.Tint(Color3.fromRGB(150, 255, 240), -0.6, 1.0, d.Duration or 2)
	Lib.Flash(c, 0.2, 0.5)
	-- anéis que CONVERGEM (efeito de "voltar no tempo") + relógio girando ao contrário
	for i = 0, 5 do
		task.delay(i * 0.18, function() Lib.Ring(feetOf(pos) + Vector3.new(0, i * 0.5, 0), c, 70 - i * 6, 2, 0.8, 0.3) end)
	end
	Lib.Sphere(pos, c, 90, 2, 1.0, 0.8)
	local clock = Util.New("Part", { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 14, 14), Anchored = true, CanCollide = false,
		CanQuery = false, Material = Enum.Material.Neon, Color = c, Transparency = 0.4, CastShadow = false }, workspace)
	local hand1 = Util.New("Part", { Size = Vector3.new(0.3, 0.3, 6), Anchored = true, CanCollide = false, CanQuery = false,
		Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1), CastShadow = false }, workspace)
	animate(d.Duration or 2, function(t)
		local base = CFrame.new(pos + Vector3.new(0, 14, 0)) * CFrame.Angles(math.rad(90), 0, 0)
		clock.CFrame = base * CFrame.Angles(0, 0, math.rad(90))
		hand1.CFrame = base * CFrame.Angles(0, -t * 40, 0) * CFrame.new(0, -0.2, -3)
		local a = 1 - math.clamp((t - 0.8) / 0.2, 0, 1)
		clock.Transparency = 1 - 0.6 * a
		if t &gt; 0.98 then clock:Destroy(); hand1:Destroy() end
	end)
	task.delay(1.0, function()
		Lib.Burst(pos, c, 120, 60, 1.3, 1.4, Color3.new(1, 1, 1))
		Lib.Sphere(pos, Color3.new(1, 1, 1), 2, 40, 0.6, 0.3)
		Lib.Shake(0.4, 0.5)
	end)
end

function E.LyreWave(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local c = d.Color or TEAL
	for i = 1, 4 do
		task.delay(i * 0.07, function()
			local cf = r.CFrame * CFrame.new(0, 0.5, -3 - i * 3)
			local ring = Lib.Ring(cf.Position, c, 3, 9 + i * 2, 0.45, 0.2)
			ring.CFrame = cf * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(90), 0, 0)
		end)
	end
	Lib.Burst((r.CFrame * CFrame.new(0, 1, -4)).Position, c, 30, 30, 0.8, 0.6)
end

------------------------------------------------------------------ RYUKO
local STORM = Color3.fromRGB(190, 225, 255)
function E.LightningWarn(d)
	if not Lib.InRange(d.Position) then return end
	local pos, r = feetOf(d.Position + Vector3.new(0, 2.8, 0)), d.Radius or 10
	local ring = Lib.Ring(pos, STORM, r * 2, r * 2, d.Delay or 0.7, 0.2)
	Lib.Ring(pos, STORM, r * 2.4, r * 0.4, d.Delay or 0.7, 0.15)
	Lib.Burst(pos, STORM, 20, 6, 0.6, d.Delay or 0.7)
end

function E.LightningStrike(d)
	local pos = d.Position
	if not Lib.InRange(pos) then return end
	Lib.Sound("Lightning")
	local top = pos + Vector3.new(0, 90, 0)
	for _ = 1, 3 do Lib.Lightning(top + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)), pos, STORM, 14, 4, 0.7, 0.35) end
	Lib.Lightning(top, pos, Color3.new(1, 1, 1), 14, 3, 0.35, 0.3)
	Lib.Flash(Color3.new(1, 1, 1), 0.6, 0.5)
	Lib.Sphere(pos, STORM, 2, (d.Radius or 10) * 2, 0.3, 0.2)
	Lib.Ring(feetOf(pos + Vector3.new(0, 2.8, 0)), STORM, 2, (d.Radius or 10) * 3, 0.5, 0.3)
	Lib.Burst(pos, STORM, 70, 50, 1.1, 0.9, Color3.new(1, 1, 1))
	Lib.Light(pos, STORM, 50, 8, 0.6)
	Lib.Shake(0.5, 0.45)
end

function E.Gale(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local rng = Random.new()
	for i = 1, Lib.Count(14) do
		local off = Vector3.new(rng:NextNumber(-7, 7), rng:NextNumber(-2, 4), 0)
		local streak = Util.New("Part", { Size = Vector3.new(0.15, 0.15, 5), Anchored = true, CanCollide = false, CanQuery = false,
			Material = Enum.Material.Neon, Color = Color3.fromRGB(220, 255, 240), Transparency = 0.3, CastShadow = false,
			CFrame = r.CFrame * CFrame.new(off + Vector3.new(0, 0, -3)) }, workspace)
		Util.Tween(streak, 0.55, { CFrame = r.CFrame * CFrame.new(off + Vector3.new(0, 0, -28)), Transparency = 1 }, Enum.EasingStyle.Quad)
		Util.Clean(streak, 0.6)
	end
	Lib.Burst((r.CFrame * CFrame.new(0, 1, -5)).Position, Color3.fromRGB(220, 255, 240), 40, 50, 1, 0.7)
end

function E.Wave(d)
	local r = root(d.Char)
	if not r or not Lib.InRange(r.Position) then return end
	local blue = Color3.fromRGB(70, 170, 255)
	local cf = CFrame.lookAt(r.Position, r.Position + d.Direction)
	local swell = Util.New("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(10, 6, 4), Anchored = true, CanCollide = false,
		CanQuery = false, Material = Enum.Material.Neon, Color = blue, Transparency = 0.5, CastShadow = false, CFrame = cf * CFrame.new(0, -1, -4) }, workspace)
	Util.Tween(swell, 0.9, { CFrame = cf * CFrame.new(0, 0, -60), Size = Vector3.new(16, 8, 6), Transparency = 1 }, Enum.EasingStyle.Quad)
	Util.Clean(swell, 1)
	Lib.Burst((cf * CFrame.new(0, 0, -5)).Position, blue, 60, 35, 1.2, 0.9, Color3.new(1, 1, 1))
	Lib.Ring(feetOf(r.Position), blue, 2, 14, 0.5, 0.25)
end

function E.Flame(d)
	local pos = d.Position
	if not Lib.InRange(pos) then return end
	local fire, ember = Color3.fromRGB(255, 120, 30), Color3.fromRGB(255, 220, 90)
	local a = Util.Anchor(feetOf(pos) + Vector3.new(0, 0.5, 0))
	local e = Lib.Emitter(a, { Texture = Config.VFX.Fire, Color = fire, Color2 = ember, Rate = 160, Speed = NumberRange.new(8, 18),
		Lifetime = NumberRange.new(0.5, 1), Spread = Vector2.new(180, 40), Direction = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.6), NumberSequenceKeypoint.new(1, 0) }),
		Acceleration = Vector3.new(0, 6, 0) })
	Lib.Ring(feetOf(pos), fire, 3, 30, 0.6, 0.4)
	Lib.Ring(feetOf(pos), ember, 3, 24, 0.5, 0.2)
	Lib.Sphere(pos, fire, 3, 24, 0.5, 0.5)
	Lib.Light(pos, fire, 35, 5, 1.8)
	Lib.Shake(0.25, 0.35)
	task.delay(1.8, function() e.Enabled = false end)
	Util.Clean(a, 3)
end

return E
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX18">
              <Properties>
                <string name="Name">Transform</string>
                <ProtectedString name="Source">--[[ Efeitos de transformação/destransformação (cinematográficos, só por script) ]]
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("MiraculousShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Registry = require(Shared.MiraculousRegistry)
local Lib = require(Shared.VFX.VFXLib)

local E = {}

-- Kwami: usa seu modelo (ReplicatedStorage/Assets/Kwamis/&lt;Nome&gt;) ou gera um orbe luminoso
local function makeKwami(hero)
	local assets = RS:FindFirstChild(Config.Folders.Assets)
	local folder = assets and assets:FindFirstChild("Kwamis")
	local src = folder and folder:FindFirstChild(hero.Kwami.Name)
	local model
	if src and src:IsA("Model") then
		model = src:Clone()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then d.Anchored = true; d.CanCollide = false; d.CanQuery = false end
		end
		model.Parent = workspace
		return model, function(cf) model:PivotTo(cf) end
	end
	local orb = Util.New("Part", {
		Shape = Enum.PartType.Ball, Size = Vector3.one * 1.3, Anchored = true, CanCollide = false, CanQuery = false,
		Material = Enum.Material.Neon, Color = hero.Colors.Glow, CastShadow = false,
	}, workspace)
	local a0 = Util.New("Attachment", { Position = Vector3.new(0, 0.5, 0) }, orb)
	local a1 = Util.New("Attachment", { Position = Vector3.new(0, -0.5, 0) }, orb)
	Util.New("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.6, LightEmission = 1,
		Color = ColorSequence.new(hero.Colors.Glow), Transparency = NumberSequence.new(0.1, 1) }, orb)
	Util.New("PointLight", { Color = hero.Colors.Glow, Range = 14, Brightness = 2 }, orb)
	Lib.Emitter(orb, { Color = hero.Colors.Glow, Rate = 25, Speed = NumberRange.new(1, 3), Lifetime = NumberRange.new(0.4, 0.8) })
	return orb, function(cf) orb.CFrame = cf end
end

local function kwamiFlight(char, hero, dur)
	local head = char:FindFirstChild("Head")
	if not head then return end
	local obj, setCF = makeKwami(hero)
	local t0 = os.clock()
	local flyTime = dur * 0.42
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / flyTime
		if t &gt;= 1 or not head.Parent then
			conn:Disconnect()
			obj:Destroy()
			if head.Parent then
				Lib.Sphere(head.Position, hero.Colors.Glow, 1, 7, 0.5)
				Lib.Burst(head.Position, hero.Colors.Glow, 40, 25, 0.9, 0.8)
				Lib.Light(head.Position, hero.Colors.Glow, 25, 4, 0.6)
			end
			return
		end
		local ang = t * math.pi * 3
		local r = 6 * (1 - t) + 0.2
		local pos = head.Position + Vector3.new(math.cos(ang) * r, 1 + (1 - t) * 3 + math.sin(ang * 1.5), math.sin(ang) * r)
		setCF(CFrame.lookAt(pos, head.Position))
	end)
end

function E.Transform(d)
	local char = d.Char
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hero = Registry.Get(d.HeroId)
	if not (hrp and hero) or not Lib.InRange(hrp.Position) then return end
	local dur = d.Duration or Config.Transform.Duration
	local swap = dur * Config.Transform.SuitSwapAt
	local c = hero.Colors.Glow
	local feet = hrp.Position - Vector3.new(0, 2.8, 0)
	Lib.Sound("Transform", hrp)

	-- fase 1: kwami voa até o Miraculous e energia começa a girar
	kwamiFlight(char, hero, dur)
	local stopAura = Lib.Aura(char, c, 20)
	Lib.Spiral(char, c, swap, 6, 4.5, 7)
	Lib.Spiral(char, hero.Colors.Primary, swap, 4, 3.2, 6)
	Lib.Ring(feet, c, 2, 14, 0.9, 0.3)
	task.delay(swap * 0.35, function() Lib.Ring(feet, c, 2, 18, 0.9, 0.3); Lib.Light(hrp.Position, c, 22, 3, 1) end)
	task.delay(swap * 0.7, function() Lib.Ring(feet, hero.Colors.Primary, 2, 22, 0.8, 0.3); Lib.Shake(0.15, 0.6) end)

	-- fase 2: clímax (troca de traje acontece no servidor neste instante)
	task.delay(swap, function()
		if not hrp.Parent then return end
		local pos = hrp.Position
		Lib.Flash(c, 0.55, 0.7)
		Lib.Sphere(pos, Color3.new(1, 1, 1), 3, 20, 0.45, 0.1)
		Lib.Sphere(pos, c, 3, 30, 0.7, 0.4)
		Lib.Pillar(feet, c, 3, 60, 0.9)
		for i = 1, 3 do Lib.Ring(feet + Vector3.new(0, i * 0.2, 0), i == 2 and hero.Colors.Primary or c, 3, 12 + i * 10, 0.5 + i * 0.15, 0.4) end
		Lib.Burst(pos, c, 90, 45, 1.3, 1.2, hero.Colors.Primary)
		Lib.Burst(pos, Color3.new(1, 1, 1), 40, 25, 0.8, 0.9)
		Lib.Light(pos, c, 40, 6, 1.0)
		Lib.Shake(0.5, 0.5)
		stopAura()
	end)

	-- fase 3: pose final com brilho residual
	task.delay(swap + 0.1, function()
		if not hrp.Parent then return end
		local stop = Lib.Aura(char, hero.Colors.Primary, 35)
		task.delay(dur - swap, stop)
		Lib.Ring(feet, hero.Colors.Primary, 4, 26, 1.2, 0.2)
	end)
end

function E.Detransform(d)
	local char = d.Char
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hero = Registry.Get(d.HeroId)
	if not (hrp and hero) or not Lib.InRange(hrp.Position) then return end
	local dur = d.Duration or Config.Transform.DetransformDuration
	local c = hero.Colors.Glow
	local feet = hrp.Position - Vector3.new(0, 2.8, 0)
	Lib.Sound("Detransform", hrp)
	local stop = Lib.Aura(char, c, 50)
	Lib.Spiral(char, c, dur * 0.6, 5, 3, 6)
	Lib.Ring(feet, c, 24, 2, dur * 0.6, 0.3)
	task.delay(dur * 0.6, function()
		stop()
		if not hrp.Parent then return end
		local pos = hrp.Position
		Lib.Flash(c, 0.35, 0.5)
		Lib.Sphere(pos, c, 2, 16, 0.5, 0.3)
		Lib.Burst(pos, c, 60, 30, 1, 1)
		Lib.Light(pos, c, 30, 4, 0.7)
		-- kwami sai do Miraculous, cansado
		local head = char:FindFirstChild("Head")
		if head then
			local obj, setCF = makeKwami(hero)
			local t0 = os.clock()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local t = (os.clock() - t0) / 1.2
				if t &gt;= 1 or not head.Parent then conn:Disconnect(); obj:Destroy() return end
				setCF(CFrame.new(head.Position + Vector3.new(math.sin(t * 6) * 2 * t, 1.5 + t * 4, 2 * t)))
			end)
		end
	end)
end

return E
</ProtectedString>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="RBX19">
            <Properties>
              <string name="Name">VFXLib</string>
              <ProtectedString name="Source">--[[
	VFXLib (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/VFX/VFXLib
	Biblioteca de efeitos 100% por script (sem IDs). Rodar SÓ no cliente.
	Respeita desempenho: escala de partículas menor em celular, limite de distância.
]]
local RS = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Config = require(RS.MiraculousShared.Config)
local Util = require(RS.MiraculousShared.Util)

local Lib = {}
local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
Lib.Scale = isMobile and Config.VFX.MobileScale or 1

local function n(x) return math.max(1, math.floor(x * Lib.Scale + 0.5)) end
Lib.Count = n

function Lib.InRange(pos)
	local cam = workspace.CurrentCamera
	return cam and (cam.CFrame.Position - pos).Magnitude &lt;= Config.VFX.MaxDistance
end

function Lib.Emitter(parent, o)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or Config.VFX.Sparkle
	e.Color = ColorSequence.new(o.Color or Color3.new(1, 1, 1), o.Color2 or o.Color or Color3.new(1, 1, 1))
	e.LightEmission = o.LightEmission or 1
	e.Size = o.Size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = o.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = o.Lifetime or NumberRange.new(0.6, 1.1)
	e.Speed = o.Speed or NumberRange.new(5, 12)
	e.SpreadAngle = o.Spread or Vector2.new(180, 180)
	e.Rate = (o.Rate or 0) * Lib.Scale
	e.Drag = o.Drag or 0
	e.Acceleration = o.Acceleration or Vector3.zero
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.EmissionDirection = o.Direction or Enum.NormalId.Top
	e.Enabled = o.Rate ~= nil and o.Rate &gt; 0
	e.Parent = parent
	return e
end

-- Explosão de partículas num ponto
function Lib.Burst(pos, color, count, speed, size, life, color2)
	local a = Util.Anchor(pos)
	local e = Lib.Emitter(a, {
		Color = color, Color2 = color2, Speed = NumberRange.new(speed * 0.5, speed), Lifetime = NumberRange.new(life * 0.6, life),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),
	})
	e:Emit(n(count))
	Debris:AddItem(a, life + 0.5)
	return a
end

-- Anel horizontal que expande
function Lib.Ring(pos, color, startSize, endSize, time, thickness, vertical)
	local p = Util.New("Part", {
		Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Color = color, Transparency = 0.2, CastShadow = false,
		Size = Vector3.new(thickness or 0.4, startSize, startSize),
		CFrame = CFrame.new(pos) * (vertical and CFrame.Angles(0, 0, 0) or CFrame.Angles(0, 0, math.rad(90))),
	}, workspace)
	Util.Tween(p, time, { Size = Vector3.new(thickness or 0.4, endSize, endSize), Transparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(p, time + 0.1)
	return p
end

-- Esfera que cresce e some
function Lib.Sphere(pos, color, startSize, endSize, time, transparency)
	local p = Util.New("Part", {
		Shape = Enum.PartType.Ball, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Color = color, Transparency = transparency or 0.3, CastShadow = false,
		Size = Vector3.one * startSize, CFrame = CFrame.new(pos),
	}, workspace)
	Util.Tween(p, time, { Size = Vector3.one * endSize, Transparency = 1 }, Enum.EasingStyle.Quad)
	Debris:AddItem(p, time + 0.1)
	return p
end

-- Coluna de luz vertical
function Lib.Pillar(pos, color, radius, height, time)
	local p = Util.New("Part", {
		Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Color = color, Transparency = 0.5, CastShadow = false,
		Size = Vector3.new(0.5, radius * 2, radius * 2), CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}, workspace)
	p.Size = Vector3.new(height, radius * 2, radius * 2)
	Util.Tween(p, time, { Size = Vector3.new(height, radius * 0.1, radius * 0.1), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(p, time + 0.1)
	return p
end

-- Linha neon entre dois pontos
function Lib.Line(p0, p1, color, width, time)
	local d = (p1 - p0)
	local p = Util.New("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Neon,
		Color = color, CastShadow = false, Size = Vector3.new(width, width, d.Magnitude),
		CFrame = CFrame.lookAt(p0 + d / 2, p1),
	}, workspace)
	if time then
		Util.Tween(p, time, { Transparency = 1, Size = Vector3.new(0.05, 0.05, d.Magnitude) })
		Debris:AddItem(p, time + 0.1)
	end
	return p
end

-- Raio ziguezague
function Lib.Lightning(p0, p1, color, segments, jitter, width, time)
	local rng = Random.new()
	local d = p1 - p0
	local prev = p0
	segments = n(segments or 10)
	local folder = Util.New("Folder", {}, workspace)
	for i = 1, segments do
		local t = i / segments
		local pt = p0 + d * t
		if i &lt; segments then
			pt += Vector3.new(rng:NextNumber(-jitter, jitter), rng:NextNumber(-jitter, jitter), rng:NextNumber(-jitter, jitter))
		end
		local seg = Lib.Line(prev, pt, color, width, nil)
		seg.Parent = folder
		prev = pt
	end
	for _, s in ipairs(folder:GetChildren()) do
		Util.Tween(s, time, { Transparency = 1, Size = Vector3.new(0.05, 0.05, s.Size.Z) })
	end
	Debris:AddItem(folder, time + 0.1)
end

-- Luz pontual temporária
function Lib.Light(pos, color, range, brightness, time)
	local a = Util.Anchor(pos)
	local l = Util.New("PointLight", { Color = color, Range = range, Brightness = brightness }, a)
	Util.Tween(l, time, { Brightness = 0, Range = 0 })
	Debris:AddItem(a, time + 0.1)
end

-- Flash de tela (Lighting local, não é ScreenGui)
local flashCC
function Lib.Flash(color, intensity, time)
	if not flashCC then
		flashCC = Util.New("ColorCorrectionEffect", { Name = "MiraculousFlash" }, Lighting)
	end
	flashCC.TintColor = color or Color3.new(1, 1, 1)
	flashCC.Brightness = intensity or 0.4
	flashCC.Contrast = 0
	Util.Tween(flashCC, time or 0.5, { Brightness = 0, TintColor = Color3.new(1, 1, 1) })
end

local tintCC
function Lib.Tint(color, saturation, time, hold)
	if not tintCC then
		tintCC = Util.New("ColorCorrectionEffect", { Name = "MiraculousTint" }, Lighting)
	end
	Util.Tween(tintCC, time * 0.3, { TintColor = color, Saturation = saturation })
	task.delay(hold or time, function()
		Util.Tween(tintCC, time, { TintColor = Color3.new(1, 1, 1), Saturation = 0 })
	end)
end

-- Tremor de câmera via CameraOffset (funciona com câmera padrão)
function Lib.Shake(intensity, time)
	local hum = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local rng = Random.new()
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local k = 1 - (os.clock() - t0) / time
		if k &lt;= 0 or not hum.Parent then
			conn:Disconnect()
			if hum.Parent then hum.CameraOffset = Vector3.zero end
			return
		end
		hum.CameraOffset = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), 0) * intensity * k
	end)
end

-- Aura contínua em um Character; retorna função para parar
function Lib.Aura(char, color, rate)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return function() end end
	local att = Util.New("Attachment", { Name = "FXAura" }, hrp)
	local e = Lib.Emitter(att, {
		Color = color, Rate = rate or 30, Speed = NumberRange.new(1, 4), Lifetime = NumberRange.new(0.8, 1.4),
		Acceleration = Vector3.new(0, 4, 0), Spread = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) }),
	})
	local light = Util.New("PointLight", { Color = color, Range = 14, Brightness = 1.5 }, hrp)
	return function()
		e.Enabled = false
		Debris:AddItem(att, 1.6)
		Util.Tween(light, 0.5, { Brightness = 0 })
		Debris:AddItem(light, 0.6)
	end
end

-- Esferas orbitando com rastro, subindo em espiral. Retorna cleanup.
function Lib.Spiral(char, color, time, count, radius, height)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	count = n(count)
	local orbs = {}
	for i = 1, count do
		local o = Util.New("Part", {
			Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7, Anchored = true, CanCollide = false, CanQuery = false,
			Material = Enum.Material.Neon, Color = color, CastShadow = false,
		}, workspace)
		local a0 = Util.New("Attachment", { Position = Vector3.new(0, 0.3, 0) }, o)
		local a1 = Util.New("Attachment", { Position = Vector3.new(0, -0.3, 0) }, o)
		Util.New("Trail", {
			Attachment0 = a0, Attachment1 = a1, Lifetime = 0.5, LightEmission = 1, Color = ColorSequence.new(color),
			Transparency = NumberSequence.new(0.1, 1),
		}, o)
		orbs[i] = o
	end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / time
		if t &gt;= 1 or not hrp.Parent then
			conn:Disconnect()
			for _, o in ipairs(orbs) do o:Destroy() end
			return
		end
		local base = hrp.Position - Vector3.new(0, 2.5, 0)
		for i, o in ipairs(orbs) do
			local ang = t * 9 + i * (math.pi * 2 / count)
			local r = radius * (1 - 0.5 * t)
			local h = ((t * 1.2 + i / count) % 1) * height
			o.Position = base + Vector3.new(math.cos(ang) * r, h, math.sin(ang) * r)
		end
	end)
end

-- Som opcional (só toca se o ID foi preenchido em Config.Sounds)
function Lib.Sound(key, parent, volume)
	local id = Config.Sounds[key]
	if not id or id == "" then return end
	local s = Util.New("Sound", { SoundId = id, Volume = volume or 1, RollOffMaxDistance = 150 }, parent or workspace)
	s:Play()
	Debris:AddItem(s, 8)
end

return Lib
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX20">
          <Properties>
            <string name="Name">ClientAPI</string>
            <ProtectedString name="Source">--[[
	ClientAPI (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/ClientAPI
	É a PONTE entre as SUAS ScreenGuis e o jogo. Dentro de um LocalScript da sua UI:
		local API = require(game.ReplicatedStorage.MiraculousShared.ClientAPI)
		botao.Activated:Connect(function() API.Transform() end)
	Funções: SelectMiraculous(id) -&gt; ok, msg | Transform() | Detransform() | UsePower(n) | Attack() | Block(bool)
	         Dodge() | Purify() | GetAimPosition() | GetCooldownRemaining(powerId) | GetHero() | GetEnergy()
	Evento:  API.Notified:Connect(function(texto) ... end)
	Atributos do Player que sua UI pode ler/observar: veja StateService.
]]
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local Config = require(script.Parent.Config)
local Registry = require(script.Parent.MiraculousRegistry)

local API = {}
local player = Players.LocalPlayer
local remotes = RS:WaitForChild(Config.RemoteFolderName)

local notify = Instance.new("BindableEvent")
API.Notified = notify.Event
remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text) notify:Fire(text) end)

local heroesLoaded = false
local function ensureRegistry()
	if not heroesLoaded then
		heroesLoaded = true
		Registry.Init(script.Parent.Heroes)
	end
end

function API.SelectMiraculous(id)
	return remotes.SelectMiraculous:InvokeServer(id)
end

function API.Transform() remotes.TransformRequest:FireServer() end
function API.Detransform() remotes.DetransformRequest:FireServer() end
function API.Attack() remotes.Attack:FireServer() end
function API.Block(on) remotes.Block:FireServer(on == true) end
function API.Purify() remotes.Purify:FireServer() end

function API.GetAimPosition()
	local cam = workspace.CurrentCamera
	local vp
	if UIS.TouchEnabled and not UIS.MouseEnabled then
		vp = cam.ViewportSize / 2
	else
		vp = UIS:GetMouseLocation()
	end
	local ray = cam:ViewportPointToRay(vp.X, vp.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { player.Character }
	local res = workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
	return res and res.Position or (ray.Origin + ray.Direction * 200)
end

function API.UsePower(index)
	if player:GetAttribute("IsVillain") then
		remotes.VillainPower:FireServer(index, API.GetAimPosition())
	else
		remotes.UsePower:FireServer(index, API.GetAimPosition())
	end
end

function API.Dodge()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local dir = hum and hum.MoveDirection or Vector3.zero
	if dir.Magnitude &lt; 0.1 and char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		dir = hrp and -hrp.CFrame.LookVector or Vector3.new(0, 0, 1)
	end
	remotes.Dodge:FireServer(dir)
end

function API.GetHero()
	ensureRegistry()
	local id = player:GetAttribute("HeroId") or player:GetAttribute("MiraculousId")
	return id and Registry.Get(id) or nil
end

function API.GetAllHeroes()
	ensureRegistry()
	return Registry.All()
end

function API.GetCooldownRemaining(powerId)
	local t = player:GetAttribute("Cd_" .. powerId)
	if not t then return 0 end
	return math.max(0, t - workspace:GetServerTimeNow())
end

function API.GetEnergy()
	return player:GetAttribute("Energy") or 0, player:GetAttribute("MaxEnergy") or Config.Energy.Max
end

-- Atalho para HawkMoth (UI de administrador/teste): akumatiza um Model (NPC com a Tag configurada ou personagem)
function API.Akumatize(targetModel, villainId)
	remotes.HawkMothAkumatize:FireServer(targetModel, villainId)
end

return API
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX21">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source">--[[
	Config (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/Config
	Todas as configurações editáveis do jogo ficam aqui.
]]
local Config = {}

Config.Debug = false

-- Nomes das pastas que VOCÊ preenche com seus modelos (o Main cria as pastas vazias se não existirem)
Config.Folders = {
	Costumes        = "Costumes",        -- ServerStorage/Costumes/&lt;Hero.Costume&gt;
	Weapons         = "Weapons",         -- ServerStorage/Weapons/&lt;Hero.Weapon&gt; (Tool ou Accessory)
	LuckyItems      = "LuckyItems",      -- ServerStorage/LuckyItems/&lt;qualquer Tool/Model/Part&gt;
	AkumaObjects    = "AkumaObjects",    -- ServerStorage/AkumaObjects/&lt;Villain.Object&gt; (Accessory/Model/Part)
	VillainCostumes = "VillainCostumes", -- ServerStorage/VillainCostumes/&lt;Villain.Costume&gt;
	Assets          = "Assets",          -- ReplicatedStorage/Assets/Kwamis/&lt;NomeDoKwami&gt; (Model)
}

Config.RemoteFolderName = "MiraculousRemotes"
Config.RemoteEvents = {
	"TransformRequest", "DetransformRequest", "UsePower", "Attack", "Block", "Dodge",
	"Purify", "VillainPower", "HawkMothAkumatize",
	"PlayVFX", "PlayAnim", "Cinematic", "Launch", "Notify",
}
Config.RemoteFunctions = { "SelectMiraculous" }

-- Posse do Miraculous: "Free" = qualquer jogador escolhe; "Attribute" = só se Player:GetAttribute("Owned_&lt;Id&gt;") == true
Config.Ownership = { Mode = "Free", AttributePrefix = "Owned_" }
Config.UniqueHolders = true -- só um jogador por Miraculous ao mesmo tempo

Config.Transform = {
	Duration = 4.4,          -- duração total da cena de transformação (s)
	SuitSwapAt = 0.62,       -- fração da cena em que o traje é trocado
	Cooldown = 3,            -- espera para se transformar de novo
	DetransformDuration = 1.8,
	TimerSeconds = 90,       -- tempo até destransformar após poder "StartsTimer" (Lucky Charm, Cataclysm...)
	MaxTransformedSeconds = nil, -- nil = sem limite
}

Config.Energy = { Max = 100, RegenPerSecond = 4 }

Config.Combat = {
	PlayerVsPlayer = false,
	Combo = {
		MaxHits = 4, Window = 0.9, Cooldown = 0.34,
		Damage = { 8, 8, 10, 16 },
		Knockback = { 0, 0, 0, 55 },
		Range = 7.5, Width = 6.5,
		StunOnLast = 0.4,
	},
	Block = { Reduction = 0.7, PerfectWindow = 0.25, PerfectStun = 1.0, FrontDot = 0.0 },
	Dodge = { Cooldown = 1.2, Invulnerable = 0.4, Speed = 70 },
	MaxAimDistance = 400,
	DummyTag = "Dummy",
}

Config.Rewind = { Seconds = 10, Interval = 0.25, MaxSeconds = 20 } -- Viperion

Config.Akuma = {
	LairPartName = "HawkMothLair",  -- Part opcional em workspace; se não existir, a borboleta vem do céu
	FlightTime = 3.2,
	ObjectHealth = 120,
	PurifyRange = 45,
	ReleasedTimeout = 30,           -- se não purificar a tempo, a akuma reinfecta o vilão
	AllowAkumatizeHeroes = false,
	HawkMothUserIds = {},           -- UserIds autorizados a akumatizar via Remote
	StudioAllowAll = true,          -- no Studio qualquer um pode testar
	NPCTag = "Akumatizable",        -- NPCs (Model com Humanoid) com esta Tag podem ser akumatizados
	Auto = { Enabled = false, Interval = 120 },
}

Config.Keys = {
	Transform = Enum.KeyCode.T, Detransform = Enum.KeyCode.Y,
	Power1 = Enum.KeyCode.Z, Power2 = Enum.KeyCode.X, Power3 = Enum.KeyCode.C, Power4 = Enum.KeyCode.V,
	Block = Enum.KeyCode.F, Dodge = Enum.KeyCode.Q, Purify = Enum.KeyCode.B,
}

Config.VFX = {
	MaxDistance = 220,
	MobileScale = 0.5, -- escala de partículas em celulares
	-- Texturas nativas do Roblox (existem em todo cliente)
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire    = "rbxasset://textures/particles/fire_main.dds",
	Smoke   = "rbxasset://textures/particles/smoke_main.dds",
}

-- Sons: cole seus próprios IDs "rbxassetid://..." aqui (vazio = sem som). Nada é inventado.
Config.Sounds = {
	Transform = "", Detransform = "", Impact = "", Block = "", Cataclysm = "",
	LuckyCharm = "", MiraculousLadybug = "", Akuma = "", Purify = "", Lightning = "",
}

return Config
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX22">
          <Properties>
            <string name="Name">MiraculousRegistry</string>
            <ProtectedString name="Source">--[[
	MiraculousRegistry (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/MiraculousRegistry
	Carrega automaticamente todo ModuleScript dentro de MiraculousShared/Heroes.
	Para ADICIONAR um novo Miraculous: crie um ModuleScript novo em Heroes (copie um existente)
	e, se tiver poderes, um módulo com o mesmo Id em ServerScriptService/MiraculousServer/Powers.
]]
local Registry = {}
local heroes, ordered = {}, {}

local DEFAULT_STATS = { MaxHealth = 120, WalkSpeed = 22, JumpPower = 60, AttackMult = 1 }
local DEFAULT_COLORS = {
	Primary = Color3.fromRGB(255, 255, 255),
	Secondary = Color3.fromRGB(30, 30, 30),
	Glow = Color3.fromRGB(255, 255, 255),
}

local function normalize(def, fileName)
	assert(type(def) == "table", fileName .. " precisa retornar uma tabela")
	def.Id = def.Id or fileName
	def.HeroName = def.HeroName or def.Id
	def.Kwami = def.Kwami or { Name = "Kwami", Concept = "?" }
	def.Costume = def.Costume or def.Id
	def.Phrases = def.Phrases or { Transform = "Transform me!", Detransform = "Transform back!" }
	def.Colors = setmetatable(def.Colors or {}, { __index = DEFAULT_COLORS })
	def.Stats = setmetatable(def.Stats or {}, { __index = DEFAULT_STATS })
	def.Powers = def.Powers or {}
	for i, p in ipairs(def.Powers) do
		p.Index = i
		p.Cooldown = p.Cooldown or 5
		p.Energy = p.Energy or 0
		p.Range = p.Range or 60
	end
	return def
end

local initialized = false
function Registry.Init(heroFolder)
	if initialized then return end
	initialized = true
	for _, mod in ipairs(heroFolder:GetChildren()) do
		if mod:IsA("ModuleScript") then
			local ok, def = pcall(require, mod)
			if ok then
				def = normalize(def, mod.Name)
				heroes[def.Id] = def
				table.insert(ordered, def)
			else
				warn("[Miraculous] Falha ao carregar herói " .. mod.Name .. ": " .. tostring(def))
			end
		end
	end
	table.sort(ordered, function(a, b) return a.Id &lt; b.Id end)
end

function Registry.Get(id) return heroes[id] end
function Registry.All() return ordered end

function Registry.GetPower(heroId, powerId)
	local h = heroes[heroId]
	if not h then return nil end
	for _, p in ipairs(h.Powers) do
		if p.Id == powerId then return p end
	end
end

return Registry
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX23">
          <Properties>
            <string name="Name">Util</string>
            <ProtectedString name="Source">--[[ Util (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/Util ]]
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Util = {}

function Util.New(class, props, parent)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

function Util.GetParts(char)
	if not char then return nil, nil end
	return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

function Util.IsAlive(char)
	local hum, hrp = Util.GetParts(char)
	return hum ~= nil and hrp ~= nil and hum.Health &gt; 0
end

function Util.Tween(inst, time, props, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function Util.Clean(inst, t)
	Debris:AddItem(inst, t)
end

-- Anchored, invisible, no-collide anchor part (para attachments/emitters)
function Util.Anchor(position, parent)
	return Util.New("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(position),
		Name = "FXAnchor",
	}, parent or workspace)
end

function Util.Flat(v) return Vector3.new(v.X, 0, v.Z) end

function Util.Unit(v, fallback)
	if v.Magnitude &lt; 1e-4 then return fallback or Vector3.new(0, 0, -1) end
	return v.Unit
end

-- Modelos -&gt; lista de Characters (Models com Humanoid vivo) a partir de Parts
function Util.CharsFromParts(parts, exclude)
	local seen, list = {}, {}
	for _, p in ipairs(parts) do
		local model = p:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChildOfClass("Humanoid") do
			model = model:FindFirstAncestorOfClass("Model")
		end
		if model and model ~= exclude and not seen[model] and Util.IsAlive(model) then
			seen[model] = true
			table.insert(list, model)
		end
	end
	return list
end

function Util.RandomUnit()
	local r = Random.new()
	return Vector3.new(r:NextNumber(-1, 1), r:NextNumber(-1, 1), r:NextNumber(-1, 1)).Unit
end

return Util
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX24">
          <Properties>
            <string name="Name">Villains</string>
            <ProtectedString name="Source">--[[
	Villains (ModuleScript) -&gt; ReplicatedStorage/MiraculousShared/Villains
	Cada vilão akumatizado. Para adicionar um novo, copie uma entrada.
	Kinds de habilidade: Shockwave, Projectile, Barrage, Dash, StunPulse
	Opcional: ServerStorage/VillainCostumes/&lt;Costume&gt;, ServerStorage/AkumaObjects/&lt;Object&gt;
]]
return {
	Stoneheart = {
		Name = "Stoneheart", Object = "StoneheartRing", Costume = "Stoneheart",
		Colors = { Primary = Color3.fromRGB(110, 110, 120), Glow = Color3.fromRGB(170, 90, 255) },
		Stats = { Health = 420, WalkSpeed = 16, DamageMult = 1.2 },
		Abilities = {
			{ Id = "Slam", Kind = "Shockwave", Cooldown = 6, Radius = 20, Damage = 24, Stun = 1.2, Knockback = 60, MinRange = 0, MaxRange = 18 },
			{ Id = "Boulder", Kind = "Projectile", Cooldown = 5, Damage = 28, Speed = 70, Range = 120, Size = 3.5, MinRange = 15, MaxRange = 100 },
