			{ Id = "WifiPulse", Kind = "StunPulse", Cooldown = 9, Radius = 22, Damage = 8, Stun = 2.0, MinRange = 0, MaxRange = 20 },
			{ Id = "DataBeam", Kind = "Projectile", Cooldown = 3, Damage = 14, Speed = 120, Range = 140, Size = 1.6, MinRange = 10, MaxRange = 120 },
			{ Id = "Warp", Kind = "Dash", Cooldown = 7, Distance = 40, Damage = 12, MinRange = 20, MaxRange = 80 },
